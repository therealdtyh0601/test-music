<!-- ======================
     TERRA-DOMUS · MUSIC ENGINE (M1: Dawn Explorer)
     Modern Hybrid 8-bit + Ambient (E2)
     ====================== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.7.77/Tone.min.js"></script>

<script>
let musicEnabled = false;

// ----------- Synth Layers -----------
const pad = new Tone.PolySynth(Tone.Synth, {
  oscillator: { type: "sine" },
  envelope: { attack: 2, decay: 1, sustain: 0.6, release: 3 }
}).toDestination();

const pluck = new Tone.Synth({
  oscillator: { type: "square" },
  envelope: { attack: 0.02, decay: 0.15, sustain: 0.2, release: 0.1 }
}).toDestination();

const pulse = new Tone.MembraneSynth({
  pitchDecay: 0.01,
  octaves: 1,
  envelope: { attack: 0.01, decay: 0.2, sustain: 0 }
}).toDestination();

// ----------- Melody (8-bit Explorer) -----------
const melody = [
  ["C5", "8n"],
  ["E5", "8n"],
  ["G5", "8n"],
  ["A5", "8n"],

  ["G5", "8n"],
  ["E5", "8n"],
  ["D5", "4n"],

  ["C5", "8n"],
  ["E5", "8n"],
  ["G5", "4n"]
];

// ----------- Ambient Pad (Background Harmony) -----------
const padChords = [
  ["C4", "E4", "G4"],
  ["A3", "C4", "E4"],
  ["F4", "A4", "C5"],
  ["G3", "B3", "D4"]
];

// ----------- Sequencing -----------
function startMusic() {
  if (musicEnabled) return;

  musicEnabled = true;
  Tone.start();

  // Pad loop (every 4 beats)
  Tone.Transport.scheduleRepeat((time) => {
    const chord = padChords[Math.floor(Math.random() * padChords.length)];
    pad.triggerAttackRelease(chord, "2n", time);
  }, "2n");

  // Gentle pulse
  Tone.Transport.scheduleRepeat((time) => {
    pulse.triggerAttackRelease("C2", "16n", time);
  }, "4n");

  // Melody loop
  let step = 0;
  Tone.Transport.scheduleRepeat((time) => {
    const [note, dur] = melody[step];
    pluck.triggerAttackRelease(note, dur, time);
    step = (step + 1) % melody.length;
  }, "8n");

  Tone.Transport.start();
}

function stopMusic() {
  if (!musicEnabled) return;
  musicEnabled = false;
  Tone.Transport.stop();
  Tone.Transport.cancel();
}

// ----------- Toggle for UI -----------
window.toggleMusic = function () {
  if (musicEnabled) stopMusic();
  else startMusic();
};
</script>
